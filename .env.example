# Скопируйте этот файл в .env и вставьте новый ключ Google AI Studio.
GOOGLE_API_KEY=

# Модели
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
YOLO_MODEL=yolo26n.pt
YOLO_UNIVERSAL_MODEL=yoloe-26n-seg.pt
WEIGHTS_DIR=data/weights

# universal — люди, 2D/3D, существа и роботы; people — только реальные люди.
DETECTION_MODE=universal
# Разделитель — вертикальная черта.
CHARACTER_PROMPTS=character|person|animated character|cartoon character|anime character|3D game character|animal character|fantasy creature|robot|mascot|humanoid|monster|alien|puppet|anthropomorphic object|vehicle character

# Локальная обработка
DEVICE=auto
ANALYSIS_FPS=8
DETECTION_CONFIDENCE=0.20
MAX_VIDEO_SECONDS=15
MAX_UPLOAD_MB=100
MAX_CANDIDATES_PER_TRACK=6
MAX_REFERENCES_PER_CHARACTER=4
MAX_CHARACTERS=3
IMAGE_SIZE=2K

# Данные заданий хранятся здесь. Относительный путь считается от корня проекта.
DATA_DIR=data/jobs
# Старые completed/failed-задания удаляются при запуске; 0 отключает автоочистку.
JOB_RETENTION_HOURS=168
